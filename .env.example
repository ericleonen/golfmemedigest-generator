# Copy this to .env.local for local development (Next reads .env.local, and it
# is git-ignored). In production these go in Vercel → Settings → Environment
# Variables instead.

# Required: your Anthropic API key (console.anthropic.com).
ANTHROPIC_API_KEY=sk-ant-...

# Shared password for the whole site. When set, every page and every API route
# is gated: visitors get a login screen, and a signed 30-day cookie keeps them
# in. When unset the gate is off entirely, which is what you want locally.
# Set it before putting the app on a public domain.
# APP_PASSWORD=

# Optional overrides -----------------------------------------------------------
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=medium        # low | medium | high | xhigh | max — lower is faster.
#                             # Defaults to medium to stay inside Vercel's 60s
#                             # function limit; raise it when self-hosting.
# VARIANT_COUNT=4             # meme variants per request
# MAX_VARIANT_COUNT=6
# REFERENCE_DIR=reference     # folder of past memes used as the style sample
# REFERENCE_SAMPLE_SIZE=3     # past memes drawn PER VARIANT (each is its own call)
# MAX_IMAGE_BYTES=3145728     # Vercel rejects request bodies over 4.5 MB anyway
# RATE_LIMIT_PER_HOUR=30      # generations per IP per hour; 0 disables the cap

# Used only to estimate the cost shown after each run, in $ per million tokens.
# Claude Opus 5 is $5 in / $25 out; change these if you switch models.
# INPUT_PRICE_PER_MTOK=5
# OUTPUT_PRICE_PER_MTOK=25

# Swap the built-in wordmark for the real artwork: drop the file in public/ and
# point at it here. Baked in at build time, so redeploy after changing it.
# NEXT_PUBLIC_LOGO=/logo.png
