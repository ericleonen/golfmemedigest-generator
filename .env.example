# Required: your Anthropic API key (console.anthropic.com).
ANTHROPIC_API_KEY=sk-ant-...

# Strongly recommended once the app is on a public domain: a shared password.
# Without it, anyone who finds the URL spends your API credits.
# APP_PASSWORD=

# Optional overrides -----------------------------------------------------------
# PORT=8787
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=high          # low | medium | high | xhigh | max — lower is faster
# VARIANT_COUNT=4             # default variants per request
# MAX_VARIANT_COUNT=6
# CORPUS_MAX_CHARS=400000     # send the whole catalogue under this, sample past it
# CORPUS_SAMPLE_TTL_MS=240000 # how long one random sample stays cache-stable
# CORPUS_PATH=data/corpus.json
# MAX_IMAGE_BYTES=8388608
# RATE_LIMIT_PER_HOUR=30      # generations per IP per hour; 0 disables the cap
